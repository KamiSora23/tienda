# ─────────────────────────────────────────────────────────────────────────────
# Deurstore con Docker. Copia este archivo como ".env" (en la misma carpeta que
# docker-compose.yml) y completa los valores marcados con  <-- CAMBIAR.
# Nunca subas tu .env a GitHub: ya está excluido en .gitignore.
# Evita el carácter "$" en las contraseñas (Docker Compose lo interpreta).
# ─────────────────────────────────────────────────────────────────────────────

# Puerto del servidor donde se abrirá el sistema (http://TU-SERVIDOR:8080).
APP_PORT=8080

# Dirección pública con la que se entra al sistema (sin "/" al final).
# Con dominio y HTTPS: https://erp.tuempresa.com   · Solo por IP: http://203.0.113.10:8080
# <-- CAMBIAR
APP_URL=http://localhost:8080
# <-- CAMBIAR (igual que APP_URL: los enlaces de los correos llevan aquí)
FRONTEND_URL=http://localhost:8080

APP_NAME=Deurstore
APP_ENV=production
APP_DEBUG=false
# Clave de cifrado (contraseñas de correo, sesiones…). Genérala UNA vez con:
#   docker compose run --rm --no-deps api php artisan key:generate --show
# y pega aquí el resultado (empieza con base64:). Si la cambias luego, se pierden los datos cifrados.
# <-- CAMBIAR
APP_KEY=
APP_TIMEZONE=America/Lima
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
LOG_LEVEL=warning

# Base de datos (el contenedor "db" la crea sola la primera vez).
DB_DATABASE=deurstore
DB_USERNAME=deurstore
# <-- CAMBIAR
DB_PASSWORD=cambia-esta-clave-larga
# <-- CAMBIAR
DB_ROOT_PASSWORD=cambia-esta-otra-clave-larga

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BCRYPT_ROUNDS=12

# Correo: NO se configura aquí. Se configura desde la app, en Panel de plataforma › Correo de la
# plataforma (y cada empresa el suyo en Configuración › Correo); la contraseña queda cifrada en la base.
# La primera vez, el superadministrador entra con un código generado en el servidor:
#   docker compose exec api php artisan user:login-code tu-correo@gmail.com
MAIL_MAILER=log

# Empresa que muestra el portal público (vacío = la primera empresa activa).
PUBLIC_PORTAL_COMPANY_ID=

# Inteligencia artificial (opcional).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# ── Primera instalación automática (opcional) ───────────────────────────────
# Si los completas, al primer arranque se crea la empresa, su administrador y el
# superadministrador. Después de instalar, BÓRRALOS de este archivo.
# Si los dejas vacíos, instala a mano con:  docker compose exec api php artisan deurstore:install
INSTALL_COMPANY_NAME=
INSTALL_COMPANY_TRADE_NAME=
INSTALL_COMPANY_RUC=
INSTALL_ADMIN_NAME=
INSTALL_ADMIN_EMAIL=
INSTALL_ADMIN_PASSWORD=
INSTALL_PLATFORM_EMAIL=
INSTALL_PLATFORM_PASSWORD=
